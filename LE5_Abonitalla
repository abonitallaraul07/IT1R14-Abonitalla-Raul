#include <stdio.h>

int main() {

	int num = 0;
	int sum = 0;

	printf("Enter positive number to ADD(zero or negative number to STOP)\n");

	printf("Enter a number: ");
	scanf("%d", &num);

	for ( ;num > 0; ) {
		sum += num;
		printf("Enter a number: ");
		scanf("%d", &num);

	}

	printf("Total sum is: %d\n",sum);

	return 0;
}
